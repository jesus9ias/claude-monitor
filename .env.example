# Claude Monitor configuration. Copy to `.env` and fill in what you need.
# `.env` is git-ignored and must never be committed or read by an AI assistant.
# Every value is optional: with an empty `.env` the monitor runs exactly as before.

# --- Server ---------------------------------------------------------------------------------------
# CLAUDE_MONITOR_PORT=4317
# CLAUDE_CONFIG_DIR=                     # defaults to ~/.claude
# CLAUDE_MONITOR_PROJECTS_DIR=           # defaults to <config>/projects
# CLAUDE_MONITOR_SESSIONS_DIR=           # defaults to <config>/sessions
# CLAUDE_MONITOR_DATA_DIR=               # monitor's own SQLite state, defaults to ./data

# --- Subscription quota (5-hour and weekly limits) ------------------------------------------------
# An OAuth token for your Claude subscription. Get one with `claude setup-token`, or use any token
# that carries the `user:profile` scope. Without it the quota panel shows "not configured".
CLAUDE_CODE_OAUTH_TOKEN=

# How to read the quota:
#   usage  -> GET /api/oauth/usage. Free. Needs the `user:profile` scope.
#   probe  -> a 1-token Messages request to the cheapest model, reading the rate-limit headers.
#             Works with inference-only tokens (`claude setup-token`) but spends a sliver of quota.
#   auto   -> try `usage`, fall back to `probe` when the token lacks the scope.  (default)
#   off    -> never call Anthropic; only the statusline feed (if installed) updates the quota.
# CLAUDE_MONITOR_QUOTA_SOURCE=auto

# Browser notification when the percent LEFT of a window drops to these values. "off" disables.
# CLAUDE_MONITOR_QUOTA_ALERTS=20,5

# Seconds between quota refreshes while some session is active. Idle: 4x this. Minimum 60.
# CLAUDE_MONITOR_QUOTA_INTERVAL=300
